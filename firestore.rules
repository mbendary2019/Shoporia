rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isStoreOwner(storeId) {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/stores/$(storeId)).data.ownerId == request.auth.uid;
    }

    // Users - read own data, write own data, admins can read all
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // Stores - public read, owners can write, admins can manage
    match /stores/{storeId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isStoreOwner(storeId) || isAdmin();
      allow delete: if isAdmin();
    }

    // Products - public read, only store owner can manage their products
    match /products/{productId} {
      allow read: if true;
      allow create: if isAuthenticated() && isStoreOwner(request.resource.data.storeId);
      allow update: if isAuthenticated() && isStoreOwner(resource.data.storeId) || isAdmin();
      allow delete: if isAuthenticated() && isStoreOwner(resource.data.storeId) || isAdmin();
    }

    // Orders - customers read own, store owners read their store's, only relevant parties can update
    match /orders/{orderId} {
      allow read: if isAuthenticated() &&
        (resource.data.customerId == request.auth.uid ||
         isStoreOwner(resource.data.storeId) ||
         isAdmin());
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() &&
        (resource.data.customerId == request.auth.uid ||
         isStoreOwner(resource.data.storeId) ||
         isAdmin());
      allow delete: if isAdmin();
    }

    // Reviews - public read, authenticated create, owner can update/delete
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
    }

    // Coupons - store owners manage their own coupons
    match /coupons/{couponId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isStoreOwner(request.resource.data.storeId);
      allow update: if isAuthenticated() && isStoreOwner(resource.data.storeId) || isAdmin();
      allow delete: if isAuthenticated() && isStoreOwner(resource.data.storeId) || isAdmin();
    }

    // Notifications - users read/manage own only
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid || isAdmin();
    }

    // Wishlists - users manage own only
    match /wishlists/{wishlistId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow write: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid);
    }

    // Bookings - customer or service store owner can access
    match /bookings/{bookingId} {
      allow read: if isAuthenticated() &&
        (resource.data.customerId == request.auth.uid ||
         isStoreOwner(resource.data.storeId) ||
         isAdmin());
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() &&
        (resource.data.customerId == request.auth.uid ||
         isStoreOwner(resource.data.storeId) ||
         isAdmin());
      allow delete: if isAdmin();
    }

    // Services - public read, only store owner can manage
    match /services/{serviceId} {
      allow read: if true;
      allow create: if isAuthenticated() && isStoreOwner(request.resource.data.storeId);
      allow update: if isAuthenticated() && isStoreOwner(resource.data.storeId) || isAdmin();
      allow delete: if isAuthenticated() && isStoreOwner(resource.data.storeId) || isAdmin();
    }

    // Categories - public read, admin manage
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Banners - public read, admin manage
    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Chat messages - only participants can access
    match /chats/{chatId} {
      allow read: if isAuthenticated() &&
        (resource.data.participant1 == request.auth.uid ||
         resource.data.participant2 == request.auth.uid);
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() &&
        (resource.data.participant1 == request.auth.uid ||
         resource.data.participant2 == request.auth.uid);

      match /messages/{messageId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated();
        allow update: if isAuthenticated() && resource.data.senderId == request.auth.uid;
      }
    }

    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
